/* 首页样式 - 清新淡绿色主题 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F8F5 0%, #FFFFFF 100%);
  position: relative;
  overflow: hidden;
}

/* 波浪装饰 */
.wave-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
}

.wave {
  position: absolute;
  width: 200%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(82, 190, 128, 0.1), transparent);
  animation: wave 8s linear infinite;
}

.wave1 {
  animation-delay: 0s;
}

.wave2 {
  animation-delay: 4s;
}

@keyframes wave {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

/* 蔬菜水果装饰图标 */
.decoration-icons {
  position: absolute;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 0;
}

.deco-icon {
  position: absolute;
  font-size: 60rpx;
  opacity: 0.15;
  animation: float-deco 6s ease-in-out infinite;
}

.deco1 {
  top: 15%;
  left: 8%;
  animation-delay: 0s;
}

.deco2 {
  top: 25%;
  right: 10%;
  animation-delay: 1s;
}

.deco3 {
  top: 45%;
  left: 5%;
  animation-delay: 2s;
}

.deco4 {
  top: 60%;
  right: 8%;
  animation-delay: 3s;
}

.deco5 {
  top: 75%;
  left: 12%;
  animation-delay: 4s;
}

.deco6 {
  top: 85%;
  right: 15%;
  animation-delay: 5s;
}

@keyframes float-deco {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-20rpx) rotate(10deg); }
}

/* 主内容 */
.content {
  padding: 40rpx 30rpx;
  position: relative;
  z-index: 1;
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-top: 60rpx;
  margin-bottom: 50rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #52BE80 0%, #27AE60 100%);
  border-radius: 50%;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(82, 190, 128, 0.3);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.logo-icon {
  font-size: 80rpx;
}

.title-group {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.main-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #2C3E50;
  margin-bottom: 15rpx;
  letter-spacing: 2rpx;
}

.sub-title {
  font-size: 24rpx;
  color: #85929E;
  letter-spacing: 1rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 35rpx;
  margin: 30rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(82, 190, 128, 0.15);
}

.welcome-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.welcome-icon {
  font-size: 48rpx;
  margin-right: 15rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #52BE80;
}

.welcome-body {
  padding-left: 10rpx;
}

.welcome-desc {
  font-size: 28rpx;
  color: #5D6D7E;
  line-height: 1.8;
}

/* 功能介绍 */
.features {
  display: flex;
  justify-content: space-between;
  margin: 40rpx 0;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 10rpx;
}

.feature-icon-bg {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 15rpx;
}

.feature-icon-bg.green {
  background: linear-gradient(135deg, #E8F8F5, #D1F2EB);
}

.feature-icon {
  font-size: 48rpx;
}

.feature-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 22rpx;
  color: #85929E;
  text-align: center;
}

/* 系统状态 */
.system-status {
  background: linear-gradient(135deg, #FFFFFF, #F8F9FA);
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border: 2rpx solid #E8F8F5;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 24rpx;
  color: #85929E;
  margin-bottom: 10rpx;
}

.status-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #2C3E50;
}

.status-online {
  color: #27AE60;
}

.status-divider {
  width: 2rpx;
  height: 40rpx;
  background: #D5DBDB;
}

/* 作者信息 */
.author-section {
  margin: 40rpx 0;
}

.author-card {
  background: linear-gradient(135deg, #52BE80, #27AE60);
  border-radius: 24rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(82, 190, 128, 0.3);
}

.author-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
}

.author-icon {
  font-size: 50rpx;
}

.author-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.author-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 8rpx;
}

.author-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.author-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 快速开始按钮 */
.quick-start {
  margin: 50rpx 0 30rpx;
}

.start-btn {
  background: linear-gradient(135deg, #52BE80, #27AE60);
  color: #FFFFFF;
  border: none;
  border-radius: 50rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(82, 190, 128, 0.4);
  transition: all 0.3s;
}

.start-btn::after {
  border: none;
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.btn-arrow {
  font-size: 36rpx;
  font-weight: bold;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 30rpx 0;
}

.footer-text {
  font-size: 22rpx;
  color: #BDC3C7;
}
